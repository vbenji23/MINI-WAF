{
  "listen": "127.0.0.1",
  "port": 8080,
  "backend": "http://127.0.0.1:5000",
  "backend_timeout": 10,
  "mode": "block",
  "anomaly_threshold": 5,
  "rate_limit": {"requests": 60, "window": 10},
  "ban": {"strikes": 5, "duration": 300, "max_duration": 86400},
  "ban_file": "bans.json",
  "allowed_methods": ["GET", "POST", "HEAD", "PUT", "DELETE", "PATCH", "OPTIONS"],
  "max_url_length": 2048,
  "max_headers": 50,
  "max_body": 1000000,
  "client_timeout": 30,
  "inspect_responses": true,
  "mask_card_numbers": true,
  "max_inspect_size": 2000000,
  "whitelist_ips": [],
  "blocklist_ips": [],
  "whitelist_paths": ["/static/"],
  "trusted_proxies": [],
  "tls": {"cert": "", "key": ""},
  "alert_webhook": "",
  "alert_format": "discord",
  "alert_on": ["banned", "trap", "leak_blocked"],
  "alert_cooldown": 60,
  "hide_backend_errors": true,
  "dashboard_token": "",
  "dashboard_ips": ["127.0.0.1", "::1"],
  "log_file": "waf.log",
  "security_headers": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
